# Only reviewed public files may enter this repository.
/*
!/.gitignore
!/README.md
!/static/
!/tools/
!/tests/
!/.github/
/tools/*
!/tools/collect_catalogue.py
!/tools/validate_catalogue.py
!/tools/genre_targets.json
!/tools/requirements.txt
/tests/*
!/tests/test_catalogue.py
!/tests/test_static_catalogue.cjs
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
/static/*
!/static/.nojekyll
!/static/index.html
!/static/settings.html
!/static/compare.html
!/static/results.html
!/static/script.js
!/static/style.css
!/static/favicon.svg
!/static/catalogue.json
!/static/vendor/
/static/vendor/*
!/static/vendor/sortable.min.js
!/static/vendor/sortable.LICENSE.txt
